{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "noEmit": true,
    "paths": {
      "@lyratui/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*", "bin/**/*", "__tests__/**/*"],
  "exclude": ["__tests__/*.bun.test.tsx"],
  "references": [{ "path": "../core" }]
}
